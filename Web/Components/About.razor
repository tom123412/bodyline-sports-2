@using Microsoft.Extensions.Options
@using Web.Facebook

@inject ILogger<About> logger
@inject FacebookApiClient facebookApiClient
@inject IOptions<FacebookOptions> options

<div class="p-2 text-center [grid-area:about] flex flex-col items-center">
    <p class="pt-2">@(Page?.About ?? options.Value.DefaultAboutMessage)</p>
</div>

@code {
    private FacebookPage? Page {get; set;}

    protected override async Task OnInitializedAsync()
    {
        try
        {
            Page = await facebookApiClient.GetPage();
        }
        catch (HttpRequestException e)
        {
            logger.LogError(e, "{exceptionMessage} getting page details for {pageId}", e.Message, options.Value.PageId);
        }
    }
}    

